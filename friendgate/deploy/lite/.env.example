# Required. Change all example values before starting.
# 可选：使用 Actions 已发布镜像时取消下行注释，并使用 pull + up --no-build。
# FRIENDGATE_IMAGE=ghcr.io/example/friendgate:friendgate-v1.0.0
LITE_ADMIN_USERNAME=admin
LITE_ADMIN_PASSWORD=replace-with-a-long-random-password
LITE_MASTER_KEY=replace-with-32-random-bytes-in-base64url

# Four intentionally separate listeners: API, admin, invite, and private guide.
LITE_PUBLIC_API_URL=https://api.example.com/v1
LITE_PUBLIC_INVITE_URL=https://invite.example.com
LITE_PUBLIC_GUIDE_URL=https://guide.example.com
# 双栈自动识别需要两个探测域名：invite4 只配置 DNS A，invite6 只配置 DNS AAAA。
LITE_PUBLIC_IPV4_PROBE_URL=https://invite4.example.com
LITE_PUBLIC_IPV6_PROBE_URL=https://invite6.example.com
# 一般不需要修改；只在可控的上游联调环境中覆盖。
LITE_UPSTREAM_BASE_URL=https://chatgpt.com/backend-api/codex
API_PORT=8080
ADMIN_PORT=8081
INVITE_PORT=8082
GUIDE_PORT=8083
# 端口默认发布到 Docker 守护进程支持的全部 IPv4/IPv6 地址；
# 正式环境请用宿主防火墙限制来源，并由 HTTPS 反向代理提供公网入口。

# Set true only after admin/invite/guide are actually served through HTTPS.
LITE_SECURE_COOKIES=true
# Example when a local reverse proxy connects from Docker bridge/private ranges.
# Keep empty when exposing the four ports directly.
LITE_TRUSTED_PROXIES=

LITE_BAN_THRESHOLD=20
LITE_BAN_WINDOW=1m
LITE_BAN_DURATION=24h
LITE_INVITE_TTL=168h
LITE_ADMIN_SESSION_TTL=12h
LITE_STICKY_SESSION_TTL=1h
LITE_ACCOUNT_COOLDOWN=5m
# 自动读取 ChatGPT 5h/7d 额度、重置时间及可用重置次数。
LITE_QUOTA_BASE_URL=https://chatgpt.com/backend-api/wham
LITE_QUOTA_SYNC_INTERVAL=5m
LITE_MAX_BODY_MIB=64
# Docker 通过 docker-compose.nginx.yml 将宿主 Nginx 只读挂载到
# /host-nginx。宿主未安装时保持这些路径，后台会显示 N/A。
LITE_NGINX_MONITOR_PATHS=/host-nginx/nginx.conf,/host-nginx/conf.d,/host-nginx/sites-enabled
LITE_NGINX_HOST_PATH=/etc/nginx
# 必须大于单个 LITE_MAX_BODY_MIB 请求；高并发大请求还需要额外余量。
TMPFS_SIZE=128m
MEMORY_LIMIT=512m
CPU_LIMIT=1.0
STOP_GRACE_PERIOD=30s
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
TZ=Asia/Shanghai
